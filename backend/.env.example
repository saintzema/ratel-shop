# FairPrice Backend Environment Variables

SECRET_KEY=your_production_secret_key_here

# Database — PostgreSQL (production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fair_price_ng

# ─── Qwen / Alibaba Cloud Model Studio (DashScope) — Zema360 brain ───
# Use your workspace MaaS endpoint if your key is workspace-scoped (sk-ws-...).
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_REASON=qwen-max
QWEN_MODEL_FAST=qwen-plus
QWEN_MODEL_VISION=qwen-vl-max

# ─── Alibaba Cloud Object Storage (OSS) ───
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=

# ─── Zema360 service-to-service + human-in-the-loop ───
# Shared secret the agent uses to call FairPrice Next.js API routes.
ZEMA_SERVICE_TOKEN=
# WhatsApp number that approves/rejects high-risk actions.
ZEMA_APPROVER_WHATSAPP=+2348162816305
