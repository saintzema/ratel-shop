# ZEMA 360 Backend — Environment Variables
# Copy this file to .env and fill in real values

# App
SECRET_KEY=your_production_secret_key_here

# Database — PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/fairprice

# Alibaba Cloud / DashScope (Qwen models)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Alibaba Cloud OSS
OSS_ACCESS_KEY_ID=LTAI5t...
OSS_ACCESS_KEY_SECRET=...
OSS_BUCKET=fairprice-zema
OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com

# Alibaba Cloud Function Compute
FC_REGION=ap-southeast-1
FC_ACCOUNT_ID=...

# FairPrice API (for MCP tool calls)
FAIRPRICE_API_URL=https://www.fairprice.ng
ZEMA_SERVICE_TOKEN=...

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_WABA_ID=...
WHATSAPP_VERIFY_TOKEN=...
ZEMA_APPROVER_WHATSAPP=+2348162816305
