generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  name            String
  password        String?
  role            UserRole             @default(customer)
  avatarUrl       String?
  location        String?
  birthday        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  isPremium       Boolean              @default(false)
  whatsappNumber  String?              @unique
  // Meta's business-scoped user ID. Since WhatsApp usernames rolled out, an
  // inbound message can arrive with NO phone number at all — the BSUID is then
  // the ONLY stable way to recognise a returning customer. Always present on
  // inbound webhooks (username adopter or not), so we record it whenever seen.
  whatsappUserId  String?              @unique
  whatsappUsername String?
  premiumExpiresAt DateTime?
  accounts        Account[]
  addresses       Address[]
  complaints      Complaint[]          @relation("UserComplaints")
  disputes        Dispute[]            @relation("BuyerDisputes")
  negotiations    NegotiationRequest[]
  notifications   Notification[]
  orders          Order[]
  reviews         Review[]
  sellers         Seller[]
  sessions        Session[]
  supportMessages SupportMessage[]
  discountUsages  UserDiscountUsage[]
  whatsAppVerifications WhatsAppVerification[]
  financingApplications FinancingApplication[]
  savedCards      SavedCard[]
}

// A tokenized Paystack card authorization — never the raw card number, which
// we never receive or store (Paystack's own Inline popup collects it directly).
// authorizationCode is the only thing capable of charging this card again, via
// Paystack's charge_authorization endpoint — treat it with the same care as a
// credential, not just an opaque ID.
model SavedCard {
  id                String   @id @default(cuid())
  userId            String
  authorizationCode String   @unique
  last4             String
  expMonth          String
  expYear           String
  cardType          String?
  bank              String?
  signature         String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Audit log of every attempt to charge a saved card — written on success AND
// failure, since these charges can be triggered by an AI agent (Ziva chat /
// WhatsApp) rather than a human directly filling out a payment form. Without
// this, "why was I charged ₦X" or "did the agent actually charge the card"
// has no answer.
model ChargeAttempt {
  id          String   @id @default(cuid())
  savedCardId String
  userId      String
  amount      Int
  reason      String
  initiatedBy String
  status      String // success | failed | error
  detail      String?
  reference   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([savedCardId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String  @default("Home")
  street    String
  city      String
  state     String
  country   String  @default("Nigeria")
  isDefault Boolean @default(false)
  phone     String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Seller {
  id             String               @id @default(cuid())
  userId         String
  businessName   String
  ownerName      String?
  ownerEmail     String?
  description    String
  logoUrl        String?
  coverImageUrl  String?
  category       String
  verified       Boolean              @default(false)
  rating         Float                @default(0.0)
  trustScore     Float                @default(50.0)
  status         SellerStatus         @default(pending)
  subscriptionPlan String              @default("Starter")
  planExpiryDate  DateTime?
  // What to fall back to when planExpiryDate passes without renewal. Null means
  // the default (Starter/free). Lets us override per-seller, e.g. a seller who
  // gets a temporary discounted-plan arrangement drops to that plan, not Starter.
  planDowngradeTo String?
  commissionRate  Float                @default(2.5)
  tier            String               @default("Standard")
  // Paystack Subaccount code (ACCT_xxx). Once set, QR/direct-payment charges
  // route the seller's exact cut here via Paystack's own split at the moment
  // of payment — settles to their bank automatically (T+1), no Transfer API
  // call needed, sidestepping the third-party-transfer business tier gate
  // entirely.
  paystackSubaccountCode String?
  kycStatus      KYCStatus            @default(not_submitted)
  bankName       String?
  accountNumber  String?
  accountName    String?
  storeUrl       String?              @unique
  location       String?
  // Structured location — onboarding already collects a state/city via the
  // address step but was silently dropping them (only the free-text `location`
  // field existed, and nothing populated it either). These are what powers
  // Jiji-style localized search: same-city results first, then same-state,
  // then everywhere else.
  state          String?
  city           String?
  weeklyOrders   String?
  currencies     String[]
  staffCount     String?
  physicalStores String?
  joinedAt       DateTime             @default(now())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  whatsappEnabled Boolean             @default(false)
  whatsappNumber String?
  // The regular business contact number(s) from onboarding — distinct from
  // whatsappNumber, which specifically gates WhatsApp-only features (QR
  // generation, product upload via chat, etc). Conflating the two meant a
  // seller who only gave a landline/non-WhatsApp number could never use them.
  phoneNumber    String?
  // Default true — sellers who go to the trouble of generating a payment QR
  // clearly want to get paid without extra friction. The HITL threshold
  // (getPayoutHitlThreshold) is the actual safety gate for high-value
  // payouts, not this flag; a seller/admin can still explicitly disable it.
  autoPayoutEnabled Boolean            @default(true)
  whatsappDirectDM  Boolean            @default(false)
  instagramAccessToken  String?
  instagramUserId       String?
  instagramUsername     String?
  instagramTokenExpiry  DateTime?
  idDocumentUrl     String?           // NIN/Passport/Driver's License scan — onboarding never actually uploaded this before
  cacDocumentUrl    String?           // CAC certificate for registered businesses — same gap
  cacRcNumber       String?
  businessRegistered Boolean          @default(false)
  complaints     Complaint[]          @relation("SellerComplaints")
  discounts      Discount[]
  disputes       Dispute[]            @relation("SellerDisputes")
  kycSubmissions KYCSubmission[]
  negotiations   NegotiationRequest[] @relation("SellerNegotiations")
  orders         Order[]              @relation("SellerOrders")
  payouts        Payout[]
  priceAlerts    PriceAlert[]
  products       Product[]
  quotes         Quote[]
  staff          SellerStaff[]
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([category])
}

// Seller-generated quotes/invoices for clients — AI-assisted natural-language
// drafting, downloadable as PDF, shareable via WhatsApp/copy-paste, and
// payable through a public link (deposit or full balance) that reuses the
// same Paystack verification path as regular checkout.
model Quote {
  id             String   @id @default(cuid())
  sellerId       String
  title          String
  clientName     String
  clientContact  String?
  items          Json // [{ description, qty, unitPrice }]
  subtotal       Float
  total          Float
  depositRequired Boolean @default(false)
  depositAmount  Float?
  amountPaid     Float    @default(0)
  status         String   @default("draft") // draft | sent | deposit_paid | paid | cancelled
  notes          String?
  currency       String   @default("NGN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  seller         Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  payments       QuotePayment[]

  @@index([sellerId])
  @@index([status])
}

// A teammate a seller invited into their dashboard with restricted permissions
// (e.g. can't touch price/stock) — free for a seller's first 3 months per the
// standing plan policy, checked at invite time against Seller.joinedAt.
model SellerStaff {
  id           String   @id @default(cuid())
  sellerId     String
  invitedEmail String
  userId       String? // set once the invited email actually has/creates an account and accepts
  canEditPrice Boolean  @default(false)
  canEditStock Boolean  @default(false)
  canManageDiscounts Boolean @default(false)
  canViewFinancials  Boolean @default(false)
  status       String   @default("invited") // invited | active | revoked
  createdAt    DateTime @default(now())
  seller       Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@unique([sellerId, invitedEmail])
}

model QuotePayment {
  id        String   @id @default(cuid())
  quoteId   String
  amount    Float
  reference String   @unique
  createdAt DateTime @default(now())
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Product {
  id               String               @id @default(cuid())
  sellerId         String
  sellerName       String
  name             String
  description      String
  price            Float
  originalPrice    Float?
  recommendedPrice Float?
  category         String
  imageUrl         String
  images           String[]
  stock            Int                  @default(1)
  priceFlag        PriceFlag            @default(none)
  isSponsored      Boolean              @default(false)
  isActive         Boolean              @default(true)
  avgRating        Float                @default(0.0)
  reviewCount      Int                  @default(0)
  soldCount        Int                  @default(0)
  condition        ProductCondition     @default(brand_new)
  externalUrl      String?
  highlights       String[]
  specs            Json?
  tags             String[]             @default([])
  subcategory      String?
  slug             String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  financingAvailable Boolean            @default(false)
  financingDownPayment Float?
  financingDepositPct  Float?             @map("financing_deposit_pct")
  isDirectPayment      Boolean            @default(false) @map("is_direct_payment")
  isTrending       Boolean              @default(false)
  deals            Deal[]
  negotiations     NegotiationRequest[]
  orders           Order[]
  priceAlerts      PriceAlert[]
  seller           Seller               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviews          Review[]
  financingApplications FinancingApplication[]

  @@index([sellerId])
  @@index([category])
  @@index([isActive])
  @@index([isTrending])
  @@index([isSponsored])
  @@index([slug])
}

model MarketplaceCategory {
  id            String                   @id @default(cuid())
  name          String                   @unique
  slug          String                   @unique
  description   String?
  icon          String?
  subcategories MarketplaceSubcategory[]
  createdAt     DateTime                 @default(now())
}

model MarketplaceSubcategory {
  id          String              @id @default(cuid())
  categoryId  String
  name        String
  slug        String
  category    MarketplaceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())

  @@unique([categoryId, name])
}

model Order {
  id                String         @id @default(cuid())
  customerId        String
  productId         String
  sellerId          String
  amount            Float
  quantity          Int            @default(1)
  status            OrderStatus    @default(pending)
  escrowStatus      EscrowStatus   @default(held)
  shippingAddress   String
  paymentMethod     String         @default("paystack")
  paymentReference  String?        // Paystack charge reference — links to the actual collected transaction (null for COD/WhatsApp/unpaid orders)
  isDirectPayment   Boolean        @default(false) @map("is_direct_payment")
  trackingStatus    TrackingStatus @default(pending)
  trackingId        String?        @unique
  carrier           String?
  trackingSteps     Json?
  sellerConfirmedAt DateTime?
  buyerConfirmedAt  DateTime?
  escrowReleasedAt  DateTime?
  customerName      String?
  sellerName        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deliveredAt       DateTime?
  chatMessages      Json?
  payoutStatus      String?        @default("none")
  statusNote        String?        // Seller-added note visible to buyer & admin (e.g. "held in customs")
  unreadAdmin       Boolean?       @default(false)
  zivaActive        Boolean?       @default(false)
  financing         Json?
  disputes          Dispute[]
  customer          User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller            Seller         @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([trackingId])
}

model Payout {
  id               String   @id @default(cuid())
  sellerId         String
  amount           Float
  grossAmount      Float?   // What the customer actually paid, before the platform fee — lets sellers/admin see the full breakdown, not just their net take
  platformFee      Float?   // grossAmount - amount, for the same statement/receipt breakdown
  label            String?  // What the payment was for (QR label / order description), for statements
  status           String   @default("pending")
  bankName         String
  accountNumber    String
  accountName      String
  orderIds         String[]
  paymentReference String?  // Links to the original Paystack charge reference for audit
  transferCode     String?  // Paystack transfer code for tracking
  isAutoPayout     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  seller           Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model NegotiationRequest {
  id             String             @id @default(cuid())
  productId      String
  customerId     String
  customerName   String
  sellerId       String
  proposedPrice  Float
  message        String?
  status         NegotiationStatus  @default(pending)
  customerWhatsapp String?
  counterPrice   Float?
  counterMessage String?
  counterStatus  NegotiationStatus?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  chatMessages   Json?
  customer       User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller         Seller             @relation("SellerNegotiations", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([sellerId])
  @@index([productId])
  @@index([status])
}

model Review {
  id               String   @id @default(cuid())
  userId           String
  userName         String
  productId        String
  rating           Int
  title            String
  body             String
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deal {
  id          String   @id @default(cuid())
  productId   String
  discountPct Float
  startAt     DateTime
  endAt       DateTime
  isActive    Boolean  @default(true)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model KYCSubmission {
  id          String    @id @default(cuid())
  sellerId    String
  sellerName  String
  idType      IDType
  idNumber    String
  documentUrl String
  status      KYCStatus @default(pending)
  reviewedBy  String?
  reviewNotes String?
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
  seller      Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model PriceAlert {
  id          String         @id @default(cuid())
  productId   String
  productName String
  sellerId    String
  sellerName  String
  alertType   PriceAlertType
  marketAvg   Float
  sellerPrice Float
  createdAt   DateTime       @default(now())
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller      Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model Complaint {
  id          String          @id @default(cuid())
  userId      String
  userName    String
  sellerId    String
  sellerName  String
  orderId     String?
  type        ComplaintType
  description String
  status      ComplaintStatus @default(complaint_open)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  seller      Seller          @relation("SellerComplaints", fields: [sellerId], references: [id], onDelete: Cascade)
  user        User            @relation("UserComplaints", fields: [userId], references: [id], onDelete: Cascade)
}

model Dispute {
  id          String        @id @default(cuid())
  orderId     String
  buyerId     String
  buyerName   String
  buyerEmail  String
  sellerId    String
  sellerName  String
  productName String
  amount      Float
  reason      DisputeReason
  description String
  status      DisputeStatus @default(open)
  adminNotes  String?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  buyer       User          @relation("BuyerDisputes", fields: [buyerId], references: [id], onDelete: Cascade)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller      Seller        @relation("SellerDisputes", fields: [sellerId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportMessage {
  id              String        @id @default(cuid())
  userName        String
  userEmail       String
  userId          String?
  subject         String
  message         String
  source          SupportSource @default(contact_form)
  status          SupportStatus @default(new_msg)
  transcript      String?
  orderId         String?
  targetUserId    String?
  targetUserEmail String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id                          String   @id @default("global")
  platformMargin              Float    @default(15.0)
  vehicleMarkup               Float    @default(12.0)
  vehicleDepositPct           Float    @default(15.0)
  serviceCharge               Float    @default(25.0)
  standardCommission          Float    @default(2.5)
  escrowFee                   Float    @default(1000)
  escrowFeePayNow             Float    @default(1950)
  doorstepFee                 Float    @default(4000)
  pickupFee                   Float    @default(2500)
  maxNegotiationDiscount      Float    @default(10.0)
  lowCostThreshold            Float    @default(5000.0)
  lowCostFlatFee              Float    @default(250.0)
  highCostThreshold           Float    @default(500000.0)
  highCostCap                 Float    @default(15000.0)
  aiMonitoring                Boolean  @default(true)
  kycVerification             Boolean  @default(false)
  escrowRelease               Boolean  @default(true)
  strictSeller                Boolean  @default(true)
  categoryMargins             Json?
  heroConfig                  Json?
  updatedAt                   DateTime @updatedAt
  codAllowExpensiveCategories Boolean  @default(true)
  codEnabled                  Boolean  @default(true)
  codGlobalEnabled            Boolean  @default(false)
  codGlobalThreshold          Float    @default(15000)
  codThreshold                Float    @default(20000)
  stateShipping               Json?
  globalSearchCaching         Boolean  @default(true)
  supportConfig               Json?
  waVerificationEnabled       Boolean  @default(false)
  whatsappNegotiationBridge   Boolean  @default(true)
  aiProvider                  String   @default("qwen")
  payoutHitlThreshold         Float    @default(50000)
  // ZEMA 360 is free/automatic for every seller today (default false = no gating).
  // Flip to true once paid-plan-only ZEMA 360 features exist and should be enforced —
  // triggerZema360 checks this before restricting anything, so leaving it false never
  // changes current behavior.
  zema360PaidPlansOnly        Boolean  @default(false)
}

model Discount {
  id         String    @id @default(cuid())
  sellerId   String
  code       String    @unique
  type       String
  value      Float
  usageLimit Int?
  usageCount Int       @default(0)
  expiry     DateTime?
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  seller     Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  usages     UserDiscountUsage[]
}

model UserDiscountUsage {
  id         String   @id @default(cuid())
  userId     String
  discountId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([userId, discountId])
}

model SearchCache {
  id        String   @id @default(cuid())
  query     String   @unique
  products  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Waitlist {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist")
}

enum UserRole {
  customer
  seller
  admin
}

enum SellerStatus {
  pending
  active
  frozen
  banned
}

enum KYCStatus {
  not_submitted
  pending
  approved
  rejected
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum EscrowStatus {
  held
  seller_confirmed
  buyer_confirmed
  auto_release_eligible
  released
  disputed
  refunded
}

enum TrackingStatus {
  pending
  processing
  shipped
  out_for_delivery
  delivered
}

enum PriceFlag {
  fair
  overpriced
  too_low
  none
  great_deal
}

enum ProductCondition {
  brand_new
  used
  refurbished
}

enum DisputeReason {
  wrong_item
  damaged
  not_received
  not_as_described
  other
}

enum DisputeStatus {
  open
  investigating
  resolved_refund
  resolved_release
}

enum NegotiationStatus {
  pending
  accepted
  rejected
  countered
}

enum SupportSource {
  ziva_escalation
  contact_form
  order_issue
  dispute_admin
}

enum SupportStatus {
  new_msg
  read
  replied
  resolved
}

enum NotificationType {
  system
  order
  negotiation
  promo
}

enum ComplaintType {
  price
  quality
  delivery
  scam
  complaint_other
}

enum ComplaintStatus {
  complaint_open
  investigating
  resolved
  dismissed
}

enum PriceAlertType {
  overpriced
  great_deal
}

enum IDType {
  nin
  drivers_license
  voters_card
  passport
}

model WhatsAppInteraction {
  id               String   @id @default(cuid())
  phoneNumber      String
  interaction_type String
  payload          String?
  createdAt        DateTime @default(now())
}

model WhatsAppVerification {
  id          String   @id @default(cuid())
  code        String   @unique
  phoneNumber String
  userId      String?
  status      VerificationStatus @default(pending)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([phoneNumber])
}

enum VerificationStatus {
  pending
  verified
  expired
  used
}

enum FinancingType {
  individual
  business
}

enum FinancingStatus {
  draft
  pending
  under_review
  approved
  rejected
  disbursed
}

model FinancingApplication {
  id                String          @id @default(cuid())
  userId            String?
  productId         String?
  type              FinancingType   @default(individual)
  status            FinancingStatus @default(pending)
  
  // Basic Loan Details
  loanAmount        Float
  tenureMonths      Int
  monthlyRepayment  Float
  interestRate      Float
  downPayment       Float           @default(0)
  insuranceFee      Float?
  
  // Applicant Details
  businessName      String?
  customerName      String?
  phoneNumber       String?
  email             String?
  employmentStatus  String?         // salary_earner, business_person
  
  // Document URLs (Stored in CDN/S3)
  cacDocumentUrl    String?
  auditedFinancialsUrl String?
  cashFlowProjectionUrl String?
  bankStatementUrl  String?
  companyProfileUrl String?
  energyAuditUrl    String?
  vendorInvoiceUrl  String?
  auditData         Json?           @map("audit_data")
  payslipData       Json?           @map("payslip_data")
  
  // Draft / multi-step form management
  currentStep       Int             @default(1)
  applicationType   String?         // 'salary_earner' | 'business_owner'
  contractType      String?         // 'long_term' | 'short_term'
  documentsJson     String?         // JSON-serialized document metadata for save/resume
  depositAmount     Float           @default(0)
  payslipsUrl       String[]

  // Applicant signature (base64 PNG data-URL)
  signatureDataUrl  String?

  // Business owner — company & directors
  companyRegistrationNumber String?
  companyLogoBase64 String?         // base64 logo for board resolution letterhead
  directorsJson     String?         // JSON array of {name,title,idNumber,bvn?,signatureDataUrl?}
  boardResolutionDataUrl String?    // Final generated board resolution as base64 image

  // Metadata
  source            String          @default("whatsapp") // whatsapp, web, app
  adminNotes        String?
  officeAddress     String?
  meetingScheduledAt DateTime?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([type])
}
model ZemaApprovalRequest {
  id             String    @id @default(cuid())
  runId          String
  orderId        String?
  status         String    @default("pending")
  agentDecision  String?
  approvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([runId])
  @@index([status])
}

model WhatsAppNegotiationSession {
  id              String   @id @default(cuid())
  sellerId        String
  negotiationId   String
  sellerPhone     String
  customerPhone   String?
  lastMessageId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sellerPhone, negotiationId])
  @@index([sellerPhone])
  @@index([lastMessageId])
}

// Manual revenue log for payments received outside the Paystack escrow flow
// (bank transfers, cash, USSD). Used as XPRIZE revenue evidence.
model OfflineTransaction {
  id              String   @id @default(cuid())
  amount          Float                          // NGN
  description     String                         // what was sold / service rendered
  buyerName       String
  paymentMethod   String   @default("bank_transfer") // bank_transfer | cash | ussd | pos
  bankReference   String?                        // bank transaction ID / receipt number
  evidenceNote    String?                        // judge-facing context note
  transactionDate DateTime                       // when payment was received
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([transactionDate])
  @@map("offline_transactions")
}
