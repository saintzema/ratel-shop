generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = "postgresql://neondb_owner:npg_OETt9q4xyHKv@ep-shiny-glade-abtv1ysp-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"
  directUrl = "postgresql://neondb_owner:npg_OETt9q4xyHKv@ep-shiny-glade-abtv1ysp.eu-west-2.aws.neon.tech/neondb?sslmode=require"
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  password         String?
  image            String?
  role             String    @default("user")
  newsletter       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  accounts         Account[]
  sessions         Session[]
  seller           Seller?
  reviews          Review[]
  orders           Order[]
  negotiations     Negotiation[]
  favorites        Favorite[]
  complaints       Complaint[]
  browsingHistory  BrowsingHistory[]
  guestSessionId   String?
  isGuest          Boolean   @default(false)
  notifications    Notification[]
  wallet           Wallet?
}

model Seller {
  id               String    @id
  userId           String    @unique
  businessName     String
  ownerName        String?   @default("Global Stores")
  ownerEmail       String?   @default("techzema@gmail.com")
  description      String?
  logoUrl          String?
  coverImageUrl    String?
  category         String?
  verified         Boolean   @default(false)
  rating           Float     @default(0)
  reviewCount      Int       @default(0)
  soldCount        Int       @default(0)
  trustScore       Int       @default(70)
  status           String    @default("pending") // pending, active, suspended
  kycStatus        String    @default("not_submitted") // not_submitted, pending, verified, rejected
  bankName         String?
  accountNumber    String?
  accountName      String?
  storeUrl         String?   @default("")
  location         String?   @default("Lagos, Nigeria")
  weeklyOrders     String?   @default("11-50")
  currencies       String[]  @default([])
  staffCount       String?   @default("6-10")
  physicalStores   String?   @default("4+")
  joinedAt         DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products         Product[]
  orders           Order[]
  negotiations     Negotiation[]
  analytics        SellerAnalytics?
  wallet           Wallet?
}

model Product {
  id               String    @id
  sellerId         String
  sellerName       String
  name             String
  description      String?
  price            Float
  originalPrice    Float?
  recommendedPrice Float?
  category         String
  imageUrl         String
  images           String[]
  stock            Int       @default(0)
  priceFlag        String    @default("none") // low, medium, high
  isSponsored      Boolean   @default(false)
  isActive         Boolean   @default(true)
  avgRating        Float     @default(0)
  reviewCount      Int       @default(0)
  soldCount        Int       @default(0)
  highlights       String[]
  specs            Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  seller           Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviews          Review[]
  negotiations     Negotiation[]
  favorites        Favorite[]
  orderItems       OrderItem[]
  tags             String[]  @default([])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  sellerId        String
  totalAmount     Float
  status          String      @default("pending") // pending, paid, processing, shipped, delivered, cancelled
  shippingAddress Json
  paymentMethod   String?
  paymentStatus   String      @default("pending") // pending, paid, failed, refunded
  escrowStatus    String      @default("held") // held, released, disputed, refunded
  trackingId      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller          Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  complaints      Complaint[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  imageUrl  String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Negotiation {
  id             String   @id @default(cuid())
  userId         String
  sellerId       String
  productId      String
  initialPrice   Float
  offeredPrice   Float
  currentPrice   Float
  status         String   @default("pending") // pending, accepted, rejected, counter-offered, expired
  conversations  Json?    // Array of message objects
  expiryDate     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller         Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
}

model Complaint {
  id          String   @id @default(cuid())
  userId      String
  orderId     String
  type        String   // delivery, quality, price, other
  subject     String
  description String
  status      String   @default("pending") // pending, investigating, resolved, closed
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model BrowsingHistory {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // order, negotiation, system, promo
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id            String   @id @default(cuid())
  userId        String?  @unique
  sellerId      String?  @unique
  balance       Float    @default(0)
  escrowBalance Float    @default(0)
  withdrawnTotal Float    @default(0)
  currency      String   @default("NGN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller        Seller?  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model SellerAnalytics {
  id               String   @id @default(cuid())
  sellerId         String   @unique
  totalViews       Int      @default(0)
  totalSales       Int      @default(0)
  conversionRate   Float    @default(0)
  activePromotions Int      @default(0)
  updatedAt        DateTime @updatedAt
  seller           Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}
